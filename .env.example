# Casebound model-provider configuration (all optional).
#
# Casebound runs fully offline with no model configured: you still get the
# normalized, ATT&CK-tagged timeline plus a deterministic findings summary.
# The narrative is an opt-in layer that defaults to a local provider so evidence
# never leaves the host. A cloud provider is opt-in only and is preceded by a
# redaction pass (PRD Hard rule 2, FR27, FR36).
#
# Copy to .env and fill in only what you need. Never commit a real .env.

# Which provider drives the narrative: local (default), anthropic, or openai.
CASEBOUND_PROVIDER=local

# Local model endpoint (Ollama or any OpenAI-compatible local server).
CASEBOUND_LOCAL_BASE_URL=http://localhost:11434
CASEBOUND_LOCAL_MODEL=llama3.1

# Cloud providers (opt-in only; requires an explicit consent flag at run time).
# Keys are never logged or written to any output (FR37).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
