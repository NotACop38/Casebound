# Casebound narrative-provider configuration (all optional).
#
# Casebound runs fully offline with no provider configured: you still get the
# normalized, ATT&CK-tagged timeline, the activity episodes, the indicators, and a
# deterministic findings summary (FR26). The narrative is an opt-in layer.
#
# The default and recommended provider is local, so evidence never leaves the host
# (PRD Hard rule 2, FR27). Cloud providers are opt-in only: you must set the consent
# flag, and every event view is redacted before any cloud call (PRD D5, FR36). API
# keys are never logged or written to any output (FR37).
#
# Copy to .env and fill in only what you need. Never commit a real .env.

# Which provider drives the narrative: local, anthropic, or openai.
# Unset (or "none") means no narrative: the deterministic no-model path (FR26).
CASEBOUND_PROVIDER=local

# Local provider: an OpenAI-compatible endpoint (for example Ollama's /v1 API).
# Needs the optional 'openai' package: pip install openai
CASEBOUND_LOCAL_BASE_URL=http://localhost:11434/v1
CASEBOUND_LOCAL_MODEL=llama3.1

# Cloud providers (opt-in only). Set the consent flag to allow any cloud call;
# Casebound redacts every event view first (PRD D5). Anthropic needs the optional
# 'anthropic' package; OpenAI needs the optional 'openai' package.
CASEBOUND_ALLOW_CLOUD=0
ANTHROPIC_API_KEY=
CASEBOUND_ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
CASEBOUND_OPENAI_MODEL=gpt-4o-mini
# Optional: point the OpenAI provider at a compatible gateway.
CASEBOUND_OPENAI_BASE_URL=

# Cloud redaction toggles (PRD D5). The defaults strip the free-text message, the
# username principal, and obvious indicators in the object; the host is kept.
CASEBOUND_REDACT_MESSAGE=1
CASEBOUND_REDACT_PRINCIPAL=1
CASEBOUND_REDACT_IOCS=1
CASEBOUND_REDACT_HOST=0
