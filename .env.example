# Casebound narrative-provider configuration. Every setting is optional.
#
# With no provider configured, Casebound runs fully offline and writes the
# deterministic report: the normalized, ATT&CK-tagged timeline, the activity
# episodes, the indicators, and the key findings, with no narrative (FR26).
#
# The recommended provider is local, so evidence never leaves the host (Hard rule
# 2). Cloud providers are opt-in: they need the consent flag, and every event view
# is redacted before any cloud call (D5, FR36). Keys are never logged or written to
# any output (FR37). Whatever the provider, the model only ever sees the compact
# event view, and every claim it drafts is checked by the deterministic verifier.
#
# Copy to .env and fill in only what you need. Never commit a real .env.

# The narrative provider: local, anthropic, openai, or none. Unset means none:
# 'casebound report' writes the deterministic report, and 'casebound demo' uses its
# bundled offline narrator so the showcase still exercises the verifier.
CASEBOUND_PROVIDER=

# Ask for JSON constrained to the claim schema where the API supports it (1 or 0).
CASEBOUND_STRUCTURED_OUTPUT=1
# Optional output ceiling in tokens for any provider. Anthropic defaults to 64000;
# OpenAI-compatible calls send none unless this is set.
CASEBOUND_MAX_OUTPUT_TOKENS=

# Local provider: any OpenAI-compatible server on this host (Ollama, llama.cpp,
# vLLM, LM Studio). Install with: pip install "casebound[local]"
# Name the model your server serves (for Ollama, see 'ollama list').
CASEBOUND_LOCAL_BASE_URL=http://localhost:11434/v1
CASEBOUND_LOCAL_MODEL=
# Only for a local server started with an API key (vLLM --api-key, LM Studio).
CASEBOUND_LOCAL_API_KEY=

# Cloud providers. Setting the consent flag to 1 (or passing --allow-cloud) is
# required for any cloud call. Install with: pip install "casebound[anthropic]" or
# pip install "casebound[openai]"
CASEBOUND_ALLOW_CLOUD=0
ANTHROPIC_API_KEY=
CASEBOUND_ANTHROPIC_MODEL=claude-opus-5
# Re-run a request Anthropic's safety classifiers decline on the fallback model
# Anthropic recommends for that category (1 or 0).
CASEBOUND_ANTHROPIC_FALLBACKS=1
OPENAI_API_KEY=
CASEBOUND_OPENAI_MODEL=
# Optional: point the OpenAI provider at a compatible gateway.
CASEBOUND_OPENAI_BASE_URL=

# Cloud redaction (D5). The defaults strip the free-text message, the principal,
# and indicators and usernames in the object; the host is kept. Techniques and
# severity always pass, since they describe an event's class, not its content.
CASEBOUND_REDACT_MESSAGE=1
CASEBOUND_REDACT_PRINCIPAL=1
CASEBOUND_REDACT_IOCS=1
CASEBOUND_REDACT_HOST=0
CASEBOUND_REDACT_PLACEHOLDER=[redacted]
