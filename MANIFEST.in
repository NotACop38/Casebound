# Source distribution contents. The wheel ships only the casebound package, with
# its schemas, ATT&CK catalog, and templates as package data (pyproject.toml); the
# sdist additionally carries a self-testable source snapshot. Style: no em dashes
# or en dashes anywhere.

include LICENSE
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include AGENTS.md
include CLAUDE.md
include Makefile
include .env.example

# The documentation, including the worked schema examples the gate validates.
graft docs

# The bundled synthetic samples. Fully synthetic and safe (see samples/README.md).
graft samples

# The test suite with its fixtures and golden files, so the tests run from an
# unpacked sdist.
graft tests

# The offline gate and the catalog builder, so 'make ci' works from an sdist.
graft scripts

# Never ship caches, compiled artifacts, or build output.
global-exclude *.py[cod]
global-exclude *.so
prune **/__pycache__
prune out
prune dist
prune build
