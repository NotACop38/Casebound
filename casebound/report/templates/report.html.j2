<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="{{ report.generator }}">
<title>{{ report.case_name }}: Casebound investigation report</title>
<style>
:root {
  --bg: #ffffff;
  --ink: #16191d;
  --muted: #5b6470;
  --faint: #8a939e;
  --line: #d9dee5;
  --panel: #f5f7f9;
  --accept: #1a7f37;
  --accept-bg: #e6f4ea;
  --reject: #b42318;
  --reject-bg: #fdecea;
  --link: #0b57b0;
  --chip: #eceff3;
  --heat: #e8590c;
  --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
}
/* Dark mode follows the reader's OS preference. Token overrides only: the report
   stays self-contained and fetches nothing. */
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1117;
    --ink: #e6edf3;
    --muted: #9aa4af;
    --faint: #6e7781;
    --line: #30363d;
    --panel: #161b22;
    --accept: #3fb950;
    --accept-bg: #12261a;
    --reject: #f85149;
    --reject-bg: #3a1614;
    --link: #58a6ff;
    --chip: #21262d;
    --heat: #f0883e;
  }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: var(--ink);
  background: var(--bg);
}
.wrap { max-width: 1040px; margin: 0 auto; padding: 36px 24px 72px; }
a { color: var(--link); text-decoration: none; }
a:hover { text-decoration: underline; }
code, .mono { font-family: var(--mono); font-size: 0.92em; }
.eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 12px; color: var(--muted); margin: 0; }
header.masthead { border-bottom: 2px solid var(--ink); padding-bottom: 18px; }
header.masthead h1 { margin: 4px 0 14px; font-size: 28px; line-height: 1.2; letter-spacing: -0.01em; word-break: break-word; }
.meta { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 0; font-size: 13.5px; }
.meta dt { color: var(--muted); }
.meta dd { margin: 0; }
.guarantee { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 14px 18px; margin: 22px 0; font-size: 14px; }
.guarantee p { margin: 0; }
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); gap: 10px; margin: 22px 0 8px; }
.stat { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; }
.stat .n { font-size: 22px; font-weight: 700; font-variant-numeric: tabular-nums; }
.stat .k { color: var(--muted); font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.05em; }
section { margin: 40px 0; }
section > h2 { font-size: 20px; margin: 0 0 6px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
.lead { color: var(--muted); margin: 8px 0 16px; font-size: 14px; }
.notice { border-left: 4px solid var(--link); background: var(--panel); padding: 12px 16px; margin: 16px 0; border-radius: 0 8px 8px 0; font-size: 14px; }
.empty { color: var(--muted); font-style: italic; }
.chip { display: inline-block; background: var(--chip); border: 1px solid var(--line); border-radius: 999px; padding: 0 8px; font-size: 11.5px; line-height: 1.7; margin: 1px 2px 1px 0; white-space: nowrap; }
.chip.tech { font-family: var(--mono); }
.chip.warn { border-color: var(--reject); color: var(--reject); }
.badge { display: inline-block; border-radius: 4px; padding: 0 7px; font-size: 11.5px; font-weight: 600; line-height: 1.8; }
.badge.ok { background: var(--accept-bg); color: var(--accept); }
.badge.reject { background: var(--reject-bg); color: var(--reject); }
.badge.drop { background: var(--ink); color: var(--bg); }
.badge.revised { background: var(--chip); color: var(--muted); }
/* Narrative and findings, grouped by episode. */
.episode-group { margin: 18px 0 26px; }
.episode-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; padding: 8px 0; border-bottom: 1px dashed var(--line); font-size: 13px; color: var(--muted); }
.episode-head strong { color: var(--ink); font-family: var(--mono); font-size: 13px; }
.entry { display: grid; grid-template-columns: 188px 1fr; gap: 4px 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
.entry .when { font-family: var(--mono); font-size: 12.5px; color: var(--muted); padding-top: 2px; white-space: nowrap; }
.entry .statement { font-size: 15.5px; word-break: break-word; }
.entry .sub { grid-column: 2; font-size: 12.5px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: center; }
.entry .sub .detection { color: var(--ink); opacity: 0.85; }
/* The rejected-claims audit. */
.audit { border: 1px solid var(--line); border-left: 4px solid var(--reject); border-radius: 0 8px 8px 0; padding: 12px 16px; margin: 12px 0; }
.audit .draft { margin: 8px 0 4px; font-style: italic; word-break: break-word; }
.audit .why, .audit .cites { font-size: 13px; color: var(--muted); word-break: break-word; }
/* The ATT&CK matrix: one column per observed tactic, cells shaded by event count. */
.matrix { display: grid; grid-template-columns: repeat(auto-fill, minmax(176px, 1fr)); gap: 10px; }
.tactic h3 { margin: 0 0 6px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
.cell { border: 1px solid var(--line); border-radius: 6px; padding: 7px 9px; margin: 0 0 6px; font-size: 12.5px; background: var(--panel); background: color-mix(in srgb, var(--heat) calc(var(--w) * 38%), var(--panel)); }
.cell .tid { font-family: var(--mono); font-size: 11.5px; color: var(--muted); }
.cell .count { float: right; font-weight: 700; font-variant-numeric: tabular-nums; }
/* Tables. */
.tablewrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td { text-align: left; padding: 7px 9px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); font-weight: 600; }
td.num { text-align: right; font-variant-numeric: tabular-nums; }
td.when { white-space: nowrap; font-family: var(--mono); font-size: 12px; }
td.wrap { word-break: break-word; }
/* The evidence appendix. */
.record { border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; margin: 12px 0; scroll-margin-top: 12px; }
.record:target { border-color: var(--link); box-shadow: 0 0 0 2px color-mix(in srgb, var(--link) 30%, transparent); }
.record h3 { margin: 0 0 8px; font-size: 12.5px; font-family: var(--mono); word-break: break-all; }
.record dl { display: grid; grid-template-columns: 150px 1fr; gap: 2px 12px; margin: 0; }
.record dt { color: var(--muted); font-size: 12.5px; }
.record dd { margin: 0; font-size: 13px; word-break: break-word; }
.record .kv { margin: 0; }
.record .kv span { color: var(--muted); }
details.problems summary { cursor: pointer; color: var(--muted); }
footer { margin-top: 56px; border-top: 1px solid var(--line); padding-top: 14px; color: var(--muted); font-size: 12.5px; }
@media (max-width: 640px) {
  .entry { grid-template-columns: 1fr; }
  .entry .sub { grid-column: 1; }
  .record dl { grid-template-columns: 1fr; }
}
@media print {
  .wrap { max-width: none; padding: 0; }
  section { break-inside: avoid-page; }
  .entry, .audit, .record, .cell { break-inside: avoid; }
  a { color: inherit; }
}
</style>
</head>
<body>
<div class="wrap">

{% macro evref(event_id) -%}
{%- if event_id in shown_ids -%}
<a href="#event-{{ event_id }}" class="mono">{{ event_id | short }}</a>
{%- else -%}
<span class="mono" title="full record in report.json">{{ event_id | short }}</span>
{%- endif -%}
{%- endmacro %}

{% macro techchips(techniques) -%}
{%- for tech in techniques -%}
<span class="chip tech{% if tech.status != 'active' %} warn{% endif %}" title="{{ tech.name }} ({{ tech.mapping_source }}{% if tech.source_id %}, written as {{ tech.source_id }}{% endif %})">{{ tech.technique_id }}</span>
{%- endfor -%}
{%- endmacro %}

<header class="masthead">
  <p class="eyebrow">Casebound investigation report</p>
  <h1>{{ report.case_name }}</h1>
  <dl class="meta">
    <dt>Evidence</dt>
    <dd>{% for item in report.inputs %}<span class="mono">{{ item.source }}</span>: {{ item.file }} ({{ item.records }} record{{ "" if item.records == 1 else "s" }}){% if not loop.last %}; {% endif %}{% endfor %}</dd>
    <dt>Narrative</dt>
    <dd>{{ report.narrative_label }}</dd>
    <dt>ATT&amp;CK</dt>
    <dd>Enterprise {{ report.attack.attack_version }}</dd>
    <dt>Generated by</dt>
    <dd>{{ report.generator }}, offline, from already-collected evidence (read-only)</dd>
  </dl>
</header>

<div class="guarantee">
  <p><strong>The guarantee.</strong> Every sentence in the narrative below is composed from
  the fields of the timeline event it links to. A language model may choose which events to
  narrate, but a claim reaches this report only after a deterministic verifier confirmed that
  its cited event exists and matches every fact it asserted (time, principal, action, object).
  Claims that failed are listed in the audit, never in the narrative.</p>
</div>

<div class="stats">
  <div class="stat"><div class="n">{{ report.stats.events }}</div><div class="k">Events</div></div>
  <div class="stat"><div class="n">{{ report.stats.hosts }}</div><div class="k">Hosts</div></div>
  <div class="stat"><div class="n">{{ report.stats.techniques }}</div><div class="k">ATT&amp;CK techniques</div></div>
  <div class="stat"><div class="n">{{ report.stats.episodes }}</div><div class="k">Episodes</div></div>
  <div class="stat"><div class="n">{{ report.stats.iocs }}</div><div class="k">Indicators</div></div>
  {% if not report.no_model %}
  <div class="stat"><div class="n">{{ report.stats.narrative_entries }}</div><div class="k">Verified claims</div></div>
  <div class="stat"><div class="n">{{ report.stats.rejected_claims }}</div><div class="k">Rejected claims</div></div>
  {% endif %}
  {% if report.stats.problems %}
  <div class="stat"><div class="n">{{ report.stats.problems }}</div><div class="k">Unparsed rows</div></div>
  {% endif %}
</div>

<section id="narrative">
  {% if report.no_model %}
  <h2>Key findings</h2>
  <div class="notice">
    <strong>No language model configured.</strong> This is the deterministic report: every event
    that exhibits an ATT&amp;CK technique or that its detection rule rated high or critical, phrased
    from its own fields and grouped by activity episode. Configure a local model to add a verified
    narrative; evidence never leaves this host by default.
  </div>
  {% else %}
  <h2>Verified narrative</h2>
  <p class="lead">Each sentence is composed from the fields of the event it links to. The model
  selected the events; the verifier confirmed each claim against its event before it could appear here.</p>
  {% endif %}
  {% if groups %}
  {% for group in groups %}
  <div class="episode-group">
    {% if group.episode %}
    <div class="episode-head">
      <strong>{{ group.episode.episode_id }}</strong>
      <span>{{ group.episode.host if group.episode.host is not none else "unattributed host" }}</span>
      <span class="mono">{{ group.episode.principal if group.episode.principal is not none else "unattributed" }}</span>
      <span>{{ group.episode.start | utc }} to {{ group.episode.end | utc }}</span>
      <span>{{ group.episode.event_count }} event{{ "" if group.episode.event_count == 1 else "s" }}</span>
    </div>
    {% endif %}
    {% for entry in group.entries %}
    <div class="entry{% if not report.no_model %} claim{% endif %}">
      <div class="when">{{ entry.datetime | utc }}</div>
      <div class="statement">{{ entry.statement }}</div>
      <div class="sub">
        <span>{{ entry.host if entry.host is not none else "" }}</span>
        <span class="detection">{{ entry.detection }}</span>
        {% if entry.severity %}<span class="chip">{{ entry.severity }}</span>{% endif %}
        {{ techchips(entry.techniques) }}
        {% if not report.no_model %}
        <span class="badge ok" title="facts the model asserted and the verifier confirmed">verified: {{ entry.verified_fields | join(", ") }}</span>
        {% if entry.round_index %}<span class="badge revised">accepted after revision round {{ entry.round_index }}</span>{% endif %}
        {% endif %}
        <span>Backing evidence: {{ evref(entry.backing_event_id) }}</span>
        {% if entry.context_citations %}<span>(also cited for context: {% for cid in entry.context_citations %}{{ evref(cid) }}{% if not loop.last %}, {% endif %}{% endfor %})</span>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endfor %}
  {% elif report.no_model %}
  <p class="empty">No event carries an ATT&amp;CK technique or a high severity, so there are no key findings. The full timeline is below.</p>
  {% else %}
  <p class="empty">The model proposed no claim that survived verification.</p>
  {% endif %}
</section>

{% if not report.no_model %}
<section id="audit">
  <h2>Rejected-claims audit</h2>
  <p class="lead">Every claim the verifier rejected, with the reason. A rejected draft is shown
  here only so the rejection can be reviewed; it is not a finding. A dropped claim never reached
  the narrative above.</p>
  {% if report.audit %}
  {% for entry in report.audit %}
  <div class="audit">
    <div>
      <span class="badge reject">{{ entry.reason }}</span>
      {% if entry.dropped %}<span class="badge drop">dropped</span>{% endif %}
      <span class="mono" style="color:var(--muted);font-size:12px;">round {{ entry.round_index }}</span>
    </div>
    <div class="draft">Model draft (rejected): "{{ entry.claim_text }}"</div>
    <div class="why">Reason: {{ entry.detail }}</div>
    {% if entry.citations %}
    <div class="cites">Cited: {% for c in entry.citations %}<code>{{ c }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</div>
    {% endif %}
  </div>
  {% endfor %}
  {% else %}
  <p class="empty">No claims were rejected.</p>
  {% endif %}
</section>
{% endif %}

<section id="attack">
  <h2>ATT&amp;CK matrix</h2>
  <p class="lead">Observed techniques under their Enterprise {{ report.attack.attack_version }} tactics,
  shaded by the number of events that exhibit each. Tags come from the source's own detection rules
  (translated to current ids when ATT&amp;CK has revoked one) or, for sources without detection rules,
  from Casebound's documented mapping table. The same data is in
  <span class="mono">attack_navigator_layer.json</span>.</p>
  {% if report.attack.columns %}
  <div class="matrix">
    {% for column in report.attack.columns %}
    <div class="tactic">
      <h3>{{ column.name }}</h3>
      {% for cell in column.cells %}
      <div class="cell" style="--w: {{ '%.2f' | format(cell.count / report.attack.max_count) }}">
        <span class="count">{{ cell.count }}</span>
        <div>{{ cell.name }}</div>
        <div class="tid">{{ cell.technique_id }}</div>
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p class="empty">No event carries an ATT&amp;CK technique.</p>
  {% endif %}
  {% if report.attack.unmapped %}
  <p class="lead">Not current ATT&amp;CK techniques (kept on their events, left off the matrix):
  {% for item in report.attack.unmapped %}<span class="chip tech warn">{{ item.technique_id }}</span> {{ item.status }}, {{ item.count }} event{{ "" if item.count == 1 else "s" }}{% if not loop.last %}; {% endif %}{% endfor %}</p>
  {% endif %}
</section>

<section id="episodes">
  <h2>Activity episodes</h2>
  <p class="lead">Events grouped by host, then split on a quiet gap or a change of acting account.
  Each episode is one actor's continuous run of activity on one host.</p>
  {% if report.episodes %}
  <div class="tablewrap">
  <table>
    <thead><tr><th>Episode</th><th>Host</th><th>Principal</th><th>From (UTC)</th><th>To (UTC)</th><th>Events</th><th>Techniques</th></tr></thead>
    <tbody>
      {% for ep in report.episodes %}
      <tr>
        <td class="mono"><span class="chip ep">{{ ep.episode_id }}</span></td>
        <td>{{ ep.host if ep.host is not none else "unattributed" }}</td>
        <td class="mono wrap">{{ ep.principal if ep.principal is not none else "unattributed" }}</td>
        <td class="when">{{ ep.start | utc }}</td>
        <td class="when">{{ ep.end | utc }}</td>
        <td class="num">{{ ep.event_count }}</td>
        <td>{% for tid in ep.techniques %}<span class="chip tech">{{ tid }}</span>{% endfor %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <p class="empty">No episodes were formed.</p>
  {% endif %}
</section>

<section id="iocs">
  <h2>Indicators of compromise</h2>
  <p class="lead">Extracted deterministically from the events. Network indicators are defanged
  (dots bracketed) so they cannot be followed by accident; hashes and paths are listed verbatim.</p>
  {% if report.iocs %}
  <div class="tablewrap">
  <table>
    <thead><tr><th>Type</th><th>Indicator</th><th>Events</th><th>Referenced by</th></tr></thead>
    <tbody>
      {% for ioc in report.iocs %}
      <tr>
        <td><span class="chip">{{ ioc.ioc_type }}</span></td>
        <td class="mono wrap">{{ ioc.defanged }}</td>
        <td class="num">{{ ioc.event_count }}</td>
        <td>{% for eid in ioc.event_ids[:8] %}{{ evref(eid) }}{% if not loop.last %}, {% endif %}{% endfor %}{% if ioc.event_count > 8 %}, and {{ ioc.event_count - 8 }} more{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <p class="empty">No indicators were extracted.</p>
  {% endif %}
</section>

<section id="timeline">
  <h2>Timeline</h2>
  <p class="lead">Every event normalized to the canonical schema, in UTC. Each id links to the full
  record in the evidence appendix.</p>
  {% if capped %}
  <div class="notice">This case has {{ report.stats.events }} events. The timeline and appendix show
  the {{ events | length }} notable ones (ATT&amp;CK-tagged, cited by the narrative, or high-severity
  detections). Every event is in <span class="mono">report.json</span> and <span class="mono">events.jsonl</span>.</div>
  {% endif %}
  <div class="tablewrap">
  <table>
    <thead><tr><th>Time (UTC)</th><th>Host</th><th>Principal</th><th>Action</th><th>Object</th><th>ATT&amp;CK</th><th>Event</th></tr></thead>
    <tbody>
      {% for ev in events %}
      <tr>
        <td class="when">{{ ev.datetime }}</td>
        <td>{{ ev.host if ev.host is not none else "" }}</td>
        <td class="mono wrap">{{ ev.principal if ev.principal is not none else "" }}</td>
        <td class="mono">{{ ev.action }}</td>
        <td class="mono wrap">{{ ev.object if ev.object is not none else "" }}</td>
        <td>{{ techchips(ev.techniques) }}</td>
        <td><a href="#event-{{ ev.event_id }}" class="mono">{{ ev.event_id | short }}</a></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</section>

<section id="appendix">
  <h2>Evidence appendix</h2>
  <p class="lead">The full canonical record of each event, with the source records it came from.
  This is the deterministic source of truth every narrative sentence is bound to.</p>
  {% for ev in events %}
  <div class="record" id="event-{{ ev.event_id }}">
    <h3>{{ ev.event_id }}</h3>
    <dl>
      <dt>message</dt><dd>{{ ev.message }}</dd>
      <dt>datetime</dt><dd class="mono">{{ ev.datetime }} ({{ ev.timestamp_desc }})</dd>
      <dt>timestamp_raw</dt><dd class="mono">{{ ev.timestamp_raw }} ({{ ev.source_timezone }})</dd>
      <dt>host</dt><dd>{{ ev.host if ev.host is not none else "" }}</dd>
      <dt>principal</dt><dd class="mono">{{ ev.principal if ev.principal is not none else "" }}</dd>
      <dt>action</dt><dd class="mono">{{ ev.action }}</dd>
      <dt>object</dt><dd class="mono">{{ ev.object if ev.object is not none else "" }}</dd>
      <dt>source</dt><dd>{{ ev.source_tool }} / {{ ev.source_artifact }}</dd>
      {% if ev.techniques %}
      <dt>attack_techniques</dt><dd>{% for tech in ev.techniques %}<div class="kv"><span class="chip tech">{{ tech.technique_id }}</span> {{ tech.name }} <span>({{ tech.mapping_source }}{% if tech.source_id %}, written as {{ tech.source_id }}{% endif %})</span></div>{% endfor %}</dd>
      {% endif %}
      {% if ev.severity %}
      <dt>severity</dt><dd>{{ ev.severity }}</dd>
      {% endif %}
      {% if ev.episode_id %}
      <dt>episode</dt><dd><span class="chip ep">{{ ev.episode_id }}</span></dd>
      {% endif %}
      {% if ev.referenced_iocs %}
      <dt>iocs</dt><dd>{% for i in ev.referenced_iocs %}<span class="chip mono">{{ i.defanged }}</span> {% endfor %}</dd>
      {% endif %}
      {% if ev.details %}
      <dt>details</dt><dd>
        {% for k, v in ev.details.items() %}
        {% if v is mapping %}
        <div class="kv"><span>{{ k }}:</span></div>
        {% for k2, v2 in v.items() %}<div class="kv" style="padding-left:16px"><span>{{ k2 }}:</span> <span class="mono" style="color:var(--ink)">{{ v2 }}</span></div>{% endfor %}
        {% elif v is sequence and v is not string %}
        <div class="kv"><span>{{ k }}:</span> <span class="mono" style="color:var(--ink)">{{ v | join(", ") }}</span></div>
        {% else %}
        <div class="kv"><span>{{ k }}:</span> <span class="mono" style="color:var(--ink)">{{ v }}</span></div>
        {% endif %}
        {% endfor %}
      </dd>
      {% endif %}
      <dt>provenance</dt><dd>{% for ref in ev.provenance %}<span class="mono">{{ ref }}</span>{% if not loop.last %}; {% endif %}{% endfor %}</dd>
    </dl>
  </div>
  {% endfor %}
</section>

{% if report.problems %}
<section id="problems">
  <h2>Unparsed rows</h2>
  <p class="lead">{{ report.stats.problems }} source row{{ "" if report.stats.problems == 1 else "s" }} could not be
  normalized and were left out of the timeline. They are reported rather than silently dropped.</p>
  <details class="problems">
    <summary>Show the reasons</summary>
    <div class="tablewrap">
    <table>
      <thead><tr><th>Source</th><th>Record</th><th>Reason</th></tr></thead>
      <tbody>
        {% for problem in problems %}
        <tr><td class="mono">{{ problem.source_tool }}: {{ problem.source_file }}</td><td class="mono">{{ problem.record }}</td><td class="wrap">{{ problem.reason }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
    {% if problems_omitted %}<p class="lead">and {{ problems_omitted }} more, listed in report.json.</p>{% endif %}
  </details>
</section>
{% endif %}

<footer>
  {{ report.generator }}. The timeline, ATT&amp;CK tags, episodes, indicators, and this appendix are
  derived with no model in the loop. Casebound assists a qualified analyst; it does not replace one.
</footer>

</div>
</body>
</html>
