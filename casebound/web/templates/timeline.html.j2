<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Casebound timeline: {{ case.title }}</title>
<style>
:root { --bg: #ffffff; --ink: #1b1f24; --muted: #5b6470; --line: #d8dee6; --panel: #f6f8fa; --link: #0a4fa0; --chip: #eaeef3; }
@media (prefers-color-scheme: dark) {
  :root { --bg: #0d1117; --ink: #e6edf3; --muted: #9198a1; --line: #30363d; --panel: #161b22; --link: #4493f8; --chip: #21262d; }
}
* { box-sizing: border-box; }
body { margin: 0; font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: var(--ink); background: var(--bg); }
.tablewrap { overflow-x: auto; }
.wrap { max-width: 1100px; margin: 0 auto; padding: 32px 24px 64px; }
header.masthead { border-bottom: 2px solid var(--ink); padding-bottom: 16px; margin-bottom: 8px; }
header.masthead h1 { margin: 0 0 4px; font-size: 24px; letter-spacing: -0.01em; }
header.masthead .tagline { color: var(--muted); margin: 0; }
.summary { display: flex; flex-wrap: wrap; gap: 10px; margin: 20px 0 8px; }
.stat { border: 1px solid var(--line); border-radius: 8px; padding: 10px 14px; min-width: 110px; }
.stat .n { font-size: 22px; font-weight: 700; }
.stat .k { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }
.lead { color: var(--muted); }
table { width: 100%; border-collapse: collapse; font-size: 13.5px; margin-top: 12px; }
th, td { text-align: left; padding: 7px 9px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { font-size: 12px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--muted); }
td.when { white-space: nowrap; }
.mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
a { color: var(--link); }
.sev { font-size: 12px; text-transform: uppercase; letter-spacing: 0.03em; }
.sev-critical, .sev-high { color: #b42318; font-weight: 700; }
.sev-medium { color: #b54708; font-weight: 600; }
.note { border-left: 3px solid var(--line); padding: 4px 12px; color: var(--muted); }
.chip { display: inline-block; background: var(--chip); border: 1px solid var(--line); border-radius: 999px; padding: 1px 8px; font-size: 11.5px; margin: 1px 2px; white-space: nowrap; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
.empty { color: var(--muted); font-style: italic; }
footer { margin-top: 48px; border-top: 1px solid var(--line); padding-top: 14px; color: var(--muted); font-size: 12.5px; }
</style>
</head>
<body>
<div class="wrap">

<header class="masthead">
  <h1>{{ case.title }}</h1>
  <p class="tagline">Source: <span class="mono">{{ case.source_label }}</span>.
  <a href="/cases/{{ case.case_id }}/report">Open the report</a> /
  <a href="/">All cases</a></p>
</header>

<div class="summary">
  <div class="stat"><div class="n">{{ stats.events }}</div><div class="k">Events</div></div>
  <div class="stat"><div class="n">{{ stats.hosts }}</div><div class="k">Hosts</div></div>
  <div class="stat"><div class="n">{{ stats.techniques }}</div><div class="k">Techniques</div></div>
  <div class="stat"><div class="n">{{ stats.episodes }}</div><div class="k">Episodes</div></div>
  <div class="stat"><div class="n">{{ stats.iocs }}</div><div class="k">Indicators</div></div>
  <div class="stat"><div class="n">{{ stats.problems }}</div><div class="k">Unparsed rows</div></div>
</div>

{% if attack.columns %}
<p class="lead">Observed ATT&amp;CK techniques ({{ attack.attack_version }}):
{% for column in attack.columns %}{% for cell in column.cells %}<span class="chip" title="{{ column.name }}: {{ cell.name }}">{{ cell.technique_id }}</span>{% endfor %}{% endfor %}
</p>
{% endif %}

<section>
  <p class="lead">Every event normalized to the canonical schema and tagged with ATT&amp;CK
  deterministically, in chronological order. The report adds the narrative or key findings,
  episodes, indicators, and the evidence appendix.</p>
  {% if capped %}
  <p class="note">This case has {{ stats.events }} events, so only the {{ events | length }} notable
  ones are listed (ATT&amp;CK-tagged, cited, or high severity). The JSON report written by
  <span class="mono">casebound report</span> carries every event.</p>
  {% endif %}
  {% if events %}
  <div class="tablewrap">
  <table>
    <thead>
      <tr><th>Time (UTC)</th><th>Host</th><th>Principal</th><th>Action</th><th>Object</th><th>Severity</th><th>ATT&amp;CK</th></tr>
    </thead>
    <tbody>
      {% for ev in events %}
      <tr>
        <td class="when mono">{{ ev.datetime | utc }}</td>
        <td>{{ ev.host or "" }}</td>
        <td class="mono">{{ ev.principal or "" }}</td>
        <td class="mono">{{ ev.action }}</td>
        <td class="mono">{{ ev.object or "" }}</td>
        <td>{% if ev.severity %}<span class="sev sev-{{ ev.severity }}">{{ ev.severity }}</span>{% endif %}</td>
        <td>{% for tech in ev.techniques %}<span class="chip" title="{{ tech.name }}">{{ tech.technique_id }}</span>{% endfor %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <p class="empty">This case has no events.</p>
  {% endif %}
</section>

<footer>
  Generated by Casebound, offline. This timeline and the linked report fetch nothing at view
  time and make no outbound connection. Evidence stays on the host.
</footer>

</div>
</body>
</html>
